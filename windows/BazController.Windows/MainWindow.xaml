<Window x:Class="BazController.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BazController Companion · Virtual Gamepad Driver &amp; Server"
        Height="620" Width="980"
        Background="{StaticResource BgPrimary}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Plus Jakarta Sans">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Zone -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" CornerRadius="10" Padding="18,12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="BAZCONTROLLER" Foreground="{StaticResource AccentAmber}" FontWeight="Black" FontSize="18" VerticalAlignment="Center" FontFamily="Consolas, JetBrains Mono"/>
                    <TextBlock Text=" · WINDOWS COMPANION (.NET 8)" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1A2438" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ActiveTransportName, StringFormat='TRANSPORT: {0}'}" Foreground="{StaticResource AccentCyan}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, JetBrains Mono"/>
                    </Border>
                    <Border Background="#1A2438" CornerRadius="6" Padding="10,5">
                        <TextBlock Text="{Binding CurrentLatencyMs, StringFormat='LATENCY: {0:F1} ms'}" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, JetBrains Mono"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Profile & Driver Status Strip -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Game Profile Selector -->
            <Border Grid.Column="0" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="14,10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GAME PROFILE:" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Width="280" Background="{StaticResource BgSurfaceVariant}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderSubtle}"/>
                </StackPanel>
            </Border>

            <!-- ViGEm Virtual Controller Status -->
            <Border Grid.Column="1" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="14,10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="ViGEm XINPUT:" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                    <TextBlock Text="EMULATING XBOX 360" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="11" FontFamily="Consolas, JetBrains Mono"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Dashboard Viewport: Live Telemetry Gauges -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Box: Analog Axes Live Visualizer -->
            <Border Grid.Column="0" Background="{StaticResource BgSurface}" CornerRadius="10" Padding="18" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="LIVE CONTROLLER AXES (HIGH-PRECISION)" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" FontFamily="Consolas, JetBrains Mono" Margin="0,0,0,14"/>

                    <!-- Steering Visualizer -->
                    <TextBlock Text="{Binding SteeringValue, StringFormat='STEERING ANGLE: {0:P0}'}" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
                    <ProgressBar Minimum="-1" Maximum="1" Value="{Binding SteeringValue}" Height="18" Margin="0,0,0,14" Foreground="{StaticResource AccentAmber}"/>

                    <!-- Throttle Visualizer -->
                    <TextBlock Text="{Binding ThrottleValue, StringFormat='THROTTLE PEDAL: {0:P0}'}" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ThrottleValue}" Height="14" Margin="0,0,0,14" Foreground="{StaticResource AccentGreen}"/>

                    <!-- Brake Visualizer -->
                    <TextBlock Text="{Binding BrakeValue, StringFormat='BRAKE PEDAL: {0:P0}'}" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding BrakeValue}" Height="14" Margin="0,0,0,14" Foreground="#EF4444"/>

                    <!-- Clutch Visualizer -->
                    <TextBlock Text="{Binding ClutchValue, StringFormat='CLUTCH: {0:P0}'}" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,0,0,4"/>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ClutchValue}" Height="14" Foreground="{StaticResource AccentCyan}"/>
                </StackPanel>
            </Border>

            <!-- Right Box: Vehicle Telemetry & Quick Indicators -->
            <Border Grid.Column="1" Background="{StaticResource BgSurface}" CornerRadius="10" Padding="18" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="TRUCK &amp; COCKPIT STATE" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="12" FontFamily="Consolas, JetBrains Mono" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#151D2C" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CURRENT GEAR" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveGearText}" Foreground="{StaticResource AccentAmber}" FontWeight="Black" FontSize="28" HorizontalAlignment="Center" FontFamily="Consolas, JetBrains Mono"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#151D2C" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PACKET RATE" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Fps, StringFormat='{0} FPS'}" Foreground="{StaticResource AccentGreen}" FontWeight="Black" FontSize="24" HorizontalAlignment="Center" FontFamily="Consolas, JetBrains Mono"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Active Game Compatibility: Direct XInput injection supports Euro Truck Simulator 2, American Truck Simulator, Forza Horizon 5, Assetto Corsa, BeamNG.drive, F1 24, SnowRunner, and all Steam controller titles."
                               Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgSurface}" CornerRadius="8" Padding="14,8" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{StaticResource TextPrimary}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock Text="BazController Engine · Zero Driver Lag Mode Active" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
