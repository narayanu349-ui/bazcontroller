<Application x:Class="BazController.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#0A0D14" />
        <SolidColorBrush x:Key="BgSurface" Color="#121824" />
        <SolidColorBrush x:Key="BgSurfaceVariant" Color="#1A2234" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#26334A" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />
    </Application.Resources>
</Application>
